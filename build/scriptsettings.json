{
    "base": 1,
    "fontStyles": [
        {
            "name": "icerlek metin Y",
            "grep": {
                "__is_regexp__": true,
                "source": "^•(\\s\\s*|\\t)",
                "global": true,
                "ignoreCase": false,
                "multiline": true
            },
            "styleCheck": false,
            "fontStyle": "Light",
            "sizeCheck": true,
            "size": 10.5,
            "replace": true,
            "from": {
                "__is_regexp__": true,
                "source": "^[•](\\t|\\s\\s*)",
                "global": false,
                "ignoreCase": false,
                "multiline": true
            },
            "to": "•\t"
        },
        {
            "name": "ana metin Y",
            "grep": {
                "__is_regexp__": true,
                "source": "^.{80,}$",
                "global": true,
                "ignoreCase": false,
                "multiline": true
            },
            "styleCheck": true,
            "fontStyle": "Regular",
            "sizeCheck": true,
            "size": 10.5,
            "replace": false,
            "from": {
                "__is_regexp__": true,
                "source": "\\t",
                "global": false,
                "ignoreCase": false,
                "multiline": false
            },
            "to": "[SKIP]"
        },
        {
            "name": "ana metin Y",
            "grep": {
                "__is_regexp__": true,
                "source": "^\\r|\\n$",
                "global": true,
                "ignoreCase": false,
