            "sizeCheck": false,
            "size": 10.5,
            "replace": false,
            "from": {
                "__is_regexp__": true,
                "source": "\\t",
                "global": false,
                "ignoreCase": false,
                "multiline": false
            },
            "to": "[SKIP]"
        },
        {
            "name": "ana metin Y",
            "grep": {
                "__is_regexp__": true,
                "source": "^.{80,}$",
                "global": true,
                "ignoreCase": false,
                "multiline": true
            },
            "styleCheck": true,
            "fontStyle": "Light",
            "sizeCheck": true,
            "size": 10.5,
