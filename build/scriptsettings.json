                "__is_regexp__": true,
                "source": "\\t",
                "global": false,
                "ignoreCase": false,
                "multiline": false
            },
            "to": "[SKIP]"
        },
        {
            "name": "baslik 2 Y",
            "grep": {
                "__is_regexp__": true,
                "source": "^[0-9]{1,3}\\.[0-9]{1,3}([ ]*|\\t).+$",
                "global": true,
                "ignoreCase": false,
                "multiline": true
            },
            "styleCheck": true,
            "fontStyle": "Bold",
            "size": 12,
            "sizeCheck": false,
            "replace": true,
            "from": {
                "__is_regexp__": true,
                "source": "\\t|\\s\\s+",
                "global": false,
                "ignoreCase": false,
                "multiline": false
            },
            "to": " "
        },
        {
            "name": "baslik 3 Y",
            "grep": {
                "__is_regexp__": true,
                "source": "^\\([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]([ ]*|\\t).+$",
                "global": true,
                "ignoreCase": false,
                "multiline": true
            },
            "styleCheck": true,
            "fontStyle": "Bold",
            "size": 12,
            "sizeCheck": false,
            "replace": true,
            "from": {
                "__is_regexp__": true,
                "source": "\\t|\\s\\s+",
                "global": false,
                "ignoreCase": false,
                "multiline": false
            },
            "to": " "
