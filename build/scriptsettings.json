        {
            "name": "baslik 1 Y",
            "grep": {
                "__is_regexp__": true,
                "source": "^DİPNOT [0-9]{1,3}\\s+–\\s+.+$",
                "global": true,
                "ignoreCase": false,
                "multiline": true
            },
            "styleCheck": true,
            "fontStyle": "Bold",
            "size": 12,
            "sizeCheck": false,
            "replace": true,
            "from": {
                "__is_regexp__": true,
                "source": "\\t|\\s\\s+",
                "global": false,
